{
  "name": "dreamcoder-desktop",
  "private": false,
  "description": "DreamCoder — AI Coding Agent Desktop App",
  "version": "0.8.0-beta.1",
  "author": "GoDiao",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoDiao/dreamcoder.git",
    "directory": "desktop"
  },
  "bugs": {
    "url": "https://github.com/GoDiao/dreamcoder/issues"
  },
  "homepage": "https://github.com/GoDiao/dreamcoder#readme",
  "scripts": {
    "prepare:ripgrep": "bun run ../scripts/prepare-ripgrep.ts",
    "dev": "vite",
    "build": "vite build && bun run build:showai-reader",
    "build:showai-reader": "bun ../vendor/showai/build-reader.ts dist/showai-reader",
    "build:sidecars": "bun run ./scripts/build-sidecars.ts",
    "build:electron": "bun run ./scripts/build-electron.ts",
    "electron:install": "node node_modules/electron/install.js",
    "electron:dev": "bun run ./scripts/electron-dev.ts",
    "electron:start": "bun run build:electron && electron electron-dist",
    "electron:pack": "bun run build && bun run build:sidecars && bun run build:electron && electron-builder --publish never -c.mac.identity=-",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "tsc --noEmit && tsc --noEmit -p electron"
  },
  "dependencies": {
    "@pierre/diffs": "^1.6.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/dompurify": "^3.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.3.3",
    "fuse.js": "^7.3.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.7",
    "mermaid": "^11.14.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-resizable-panels": "^4.15.0",
    "shiki": "^4.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^3.0.4"
  }
}
