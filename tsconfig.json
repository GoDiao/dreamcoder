{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "color-diff-napi": [
        "./stubs/color-diff-napi.ts"
      ],
      "src/*": [
        "./src/*"
      ],
      "@protocol": [
        "./src/server/ws/protocol.ts"
      ]
    },
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src",
    "scripts",
    "stubs",
    "preload.ts",
    "testPreload.ts"
  ]
}
