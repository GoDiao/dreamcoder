[
  {
    "kind": "archify",
    "name": "Archify 交互架构图",
    "version": "1.2.0",
    "description": "保留 Archify 3.1 原生阅读器的十类交互图：工作流、系统架构、时序、数据流、生命周期、实体关系、类与接口、树形结构、时间线和瀑布追踪，支持节点查找、路径探索、动静切换与导出。",
    "scenarios": [
      "解释系统模块的职责、调用路径和状态变化。",
      "让读者在同一图形中查找节点、追踪路径和切换视觉样式。"
    ],
    "effects": [
      "通过 / 插入到页面或白板，沿用宿主的组件设置菜单。",
      "解锁后操作图形；阅读操作只改变当前视图。",
      "保存文字和源码修改；下载独立 SVG 或离线 HTML。",
      "新图默认将标题和说明放在外部，补充说明可折叠或隐藏；可切回完整原版。"
    ],
    "defaultData": {
      "template": "workflow",
      "height": 560,
      "presentation": {
        "title": "outside",
        "description": "outside",
        "notes": "hidden",
        "legend": true,
        "controls": true
      }
    },
    "propsSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "workflow",
            "architecture",
            "sequence",
            "dataflow",
            "lifecycle",
            "erd",
            "class",
            "tree",
            "timeline",
            "waterfall",
            "custom"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608,
          "pattern": "<[sS][vV][gG]\\b"
        },
        "title": {
          "type": "string",
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "height": {
          "type": "number",
          "minimum": 240,
          "maximum": 1200
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "enum": [
                "inside",
                "outside",
                "hidden"
              ]
            },
            "description": {
              "type": "string",
              "enum": [
                "inside",
                "outside",
                "hidden"
              ]
            },
            "notes": {
              "type": "string",
              "enum": [
                "inline",
                "details",
                "hidden"
              ]
            },
            "legend": {
              "type": "boolean"
            },
            "controls": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "template"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "template": {
                "const": "custom"
              }
            }
          },
          "then": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
