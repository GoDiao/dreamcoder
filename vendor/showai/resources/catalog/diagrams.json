    "kind": "fireworks-tech-graph",
    "name": "Fireworks 技术图",
    "version": "1.1.0",
    "description": "Fireworks Tech Graph 的 12 种技术图风格，保留原版 SVG 及语义连线，支持文字修改、完整 SVG/HTML 导入和离线导出。",
    "scenarios": [
      "解释 Agent、存储、服务、云部署和事件流。",
      "为同一类技术内容选择适合读者的视觉语言。"
    ],
    "effects": [
      "通过 / 插入到页面或白板，沿用宿主的组件设置菜单。",
      "解锁后操作图形；阅读操作只改变当前视图。",
      "保存文字和源码修改；下载独立 SVG 或离线 HTML。",
      "新图默认将标题和说明放在外部，补充说明可折叠或隐藏；可切回完整原版。"
    ],
    "defaultData": {
      "template": "style-6",
      "height": 560,
      "presentation": {
        "title": "outside",
        "description": "outside",
        "notes": "hidden",
        "legend": true,
        "controls": true
      }
    },
    "propsSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "style-1",
            "style-2",
            "style-3",
            "style-4",
            "style-5",
            "style-6",
            "style-7",
            "style-8",
            "style-9",
            "style-10",
            "style-11",
            "style-12",
            "custom"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608,
          "pattern": "<[sS][vV][gG]\\b"
