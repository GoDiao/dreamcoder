        "title": {
          "type": "string",
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "height": {
          "type": "number",
          "minimum": 240,
          "maximum": 1200
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "enum": [
                "inside",
                "outside",
                "hidden"
              ]
            },
            "description": {
              "type": "string",
              "enum": [
                "inside",
                "outside",
                "hidden"
              ]
            },
            "notes": {
              "type": "string",
              "enum": [
                "inline",
                "details",
                "hidden"
              ]
            },
            "legend": {
              "type": "boolean"
            },
            "controls": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "template"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "template": {
                "const": "custom"
              }
            }
          },
          "then": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              }
            }
          }
        }
      ]
